import json
import os

# File where expenses will be saved
FILE_NAME = "expenses.json"

def load_expenses():
    """Loads expenses from the JSON file. Creates an empty list if file doesn't exist."""
    if not os.path.exists(FILE_NAME):
        return []
    with open(FILE_NAME, "r") as file:
        return json.load(file)

def save_expenses(expenses):
    """Saves the current list of expenses to the JSON file."""
    with open(FILE_NAME, "w") as file:
        json.dump(expenses, file, indent=4)

def add_expense(expenses):
    """Prompts the user to add a new expense."""
    item = input("Enter the item name (e.g., Lunch, Taxi): ")
    try:
        amount = float(input("Enter the amount: "))
    except ValueError:
        print("Invalid amount! Please enter a number.")
        return

    expense = {"item": item, "amount": amount}
    expenses.append(expense)
    save_expenses(expenses)
    print(f"Success! Added '{item}' costing ₹{amount} to your expenses.\n")

def view_expenses(expenses):
    """Displays all saved expenses."""
    if not expenses:
        print("Your expense list is empty!\n")
        return
    
    print("\n--- Your Expenses ---")
    for index, exp in enumerate(expenses, 1):
        print(f"{index}. {exp['item']} : ₹{exp['amount']}")
    print("---------------------\n")

def show_total(expenses):
    """Calculates and shows the total amount spent."""
    total = sum(exp['amount'] for exp in expenses)
    print(f"\nTotal Amount Spent: ₹{total}\n")

def main():
    """Main menu loop for the application."""
    expenses = load_expenses()
    
    while True:
        print("=== Expense Tracker Menu ===")
        print("1. Add an Expense")
        print("2. View All Expenses")
        print("3. Show Total Spent")
        print("4. Exit")
        
        choice = input("Choose an option (1-4): ")
        
        if choice == '1':
            add_expense(expenses)
        elif choice == '2':
            view_expenses(expenses)
        elif choice == '3':
            show_total(expenses)
        elif choice == '4':
            print("Exiting Expense Tracker. Have a great day!")
            break
        else:
            print("Invalid choice. Please select a valid option.\n")

if __name__ == "__main__":
    main()